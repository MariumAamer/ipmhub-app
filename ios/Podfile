# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# Firebase iOS SDK (used by @react-native-firebase) requires iOS 15.0 as
# of the version pinned in this project — React Native's own default
# (min_ios_version_supported, currently 13.4) is too low and causes
# CocoaPods to fail resolving RNFBApp/RNFBMessaging with "required a
# higher minimum deployment target". Hardcoding 15.0 here instead of
# using RN's default. Must stay in sync with IPHONEOS_DEPLOYMENT_TARGET
# in project.pbxproj (also set to 15.1). Bumped 15.0 -> 15.1 for React Native
# 0.80, whose min_ios_version_supported is 15.1.
platform :ios, '15.1'
prepare_react_native_project!

# React Native Firebase (Messaging) requires static frameworks since
# firebase-ios-sdk v9+ / RNFB v15+ — without this, `pod install` fails
# trying to resolve Firebase/Messaging. Setting this unconditionally
# (rather than relying on the USE_FRAMEWORKS env var below, which
# Codemagic doesn't set by default) so it works the same locally and in CI.
$RNFirebaseAsStaticFramework = true

linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'IPMMobileApp' do
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'IPMMobileAppTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26.4+ (clang) rejects the consteval code in the bundled fmt pod
    # ("call to consteval function ... is not a constant expression" in
    # fmt/src/format.cc). React Native 0.80 has no official fix, so build
    # only the fmt pod as C++17, where consteval is not used.
    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |build_config|
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end

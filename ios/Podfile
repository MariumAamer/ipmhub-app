# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

# React Native 0.87 changed several CocoaPods defaults. To keep this first
# 0.87 build as close as possible to the (working) 0.80 setup, we opt out of
# them here. Each can be flipped later, one at a time, once 0.87 builds green.
#
#  * RCT_USE_PREBUILT_RNCORE / RCT_USE_RN_DEP: 0.87 downloads a prebuilt React
#    Native core + dependencies (faster CI builds) by default. This app links
#    everything as static frameworks (required by Firebase) and I could not
#    verify the prebuilt path with that setup without a Mac, so we keep
#    building from source. (This is also why the fmt workaround below stays.)
#  * RCT_REMOVE_LEGACY_ARCH: 0.87 strips the legacy-architecture code by
#    default. Some native modules here (notably the archived @notifee/react-native)
#    may still reference legacy bridge APIs, so keep it compiled in for now.
#  * New Architecture (Fabric/TurboModules) CANNOT be disabled as of React
#    Native 0.82+ — confirmed directly from RN's own pod install warning:
#    "Calling pod install with RCT_NEW_ARCH_ENABLED=0 is not supported
#    anymore... The application will run with the New Architecture enabled
#    by default." Tried anyway via ENV['RCT_NEW_ARCH_ENABLED'] plus explicit
#    new_arch_enabled:/fabric_enabled: params to use_react_native! — none of
#    it changes anything on 0.87, by design. Not attempting this again;
#    any iOS-specific rendering issues need fixing within the New
#    Architecture, not by trying to escape it.
ENV['RCT_USE_PREBUILT_RNCORE'] = '0'
ENV['RCT_USE_RN_DEP'] = '0'
ENV['RCT_REMOVE_LEGACY_ARCH'] = '0'

# Firebase iOS SDK (used by @react-native-firebase) requires iOS 15.0 as
# of the version pinned in this project — React Native's own default
# (min_ios_version_supported, currently 13.4) is too low and causes
# CocoaPods to fail resolving RNFBApp/RNFBMessaging with "required a
# higher minimum deployment target". Hardcoding 15.0 here instead of
# using RN's default. Must stay in sync with IPHONEOS_DEPLOYMENT_TARGET
# in project.pbxproj (also set to 15.1). Bumped 15.0 -> 15.1 for React Native
# 0.80, whose min_ios_version_supported is 15.1 (still 15.1 in 0.87).
platform :ios, '15.1'
prepare_react_native_project!

# React Native Firebase (Messaging) requires static frameworks since
# firebase-ios-sdk v9+ / RNFB v15+ — without this, `pod install` fails
# trying to resolve Firebase/Messaging. Setting this unconditionally
# (rather than relying on the USE_FRAMEWORKS env var below, which
# Codemagic doesn't set by default) so it works the same locally and in CI.
$RNFirebaseAsStaticFramework = true

linkage = ENV['USE_FRAMEWORKS'] || 'static'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym

target 'IPMMobileApp' do
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'IPMMobileAppTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 26.4+ (clang) rejects the consteval code in the bundled fmt pod
    # ("call to consteval function ... is not a constant expression" in
    # fmt/src/format.cc). Kept for the from-source build above (harmless if the
    # fmt target does not exist, e.g. once prebuilt dependencies are enabled):
    # build only the fmt pod as C++17, where consteval is not used.
    installer.pods_project.targets.each do |target|
      if target.name == 'fmt'
        target.build_configurations.each do |build_config|
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end
  end
end

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!--
      Required by react-native-image-picker's launchImageLibrary() for the
      "Add Photos" flow in CreatePostScreen.tsx (and any other screen using
      the shared pickImage() helper in editShared.tsx).

      Without these declared here, the library's own runtime permission
      request has nothing to ask the OS for — on a lot of real Android
      devices/OEM builds this doesn't block the picker UI from opening or
      even from returning a content:// URI, but it silently blocks the app
      from actually reading that URI's bytes afterwards. That's what turns
      into "pick a photo, tap Post, the post goes through with no image and
      no error" — the exact symptom reported, and it lines up with
      uploadImages() in CreatePostScreen.tsx previously swallowing that
      failure in a bare catch{} instead of surfacing it.

      READ_MEDIA_IMAGES covers Android 13+ (API 33+), where the granular
      per-media-type permission replaced the old blanket storage permission.
      READ_EXTERNAL_STORAGE is capped at maxSdkVersion 32 — on 13+ it's a
      no-op (superseded by READ_MEDIA_IMAGES) and Google Play policy flags
      apps that request broad storage access they don't need on new SDKs.
    -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!--
      Required for push notifications (Firebase Cloud Messaging) on
      Android 13+ (API 33+). Before API 33, notifications were shown
      without an explicit runtime permission — on 13+, the app must both
      declare this AND request it at runtime (via PermissionsAndroid or
      the Firebase messaging service) or notifications are silently
      dropped, no error, no crash, they just never show.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.google.android.youtube" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="youtube" />
        </intent>
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme">

      <!--
        Default notification channel for FCM. Android 8+ (API 26+) requires
        every notification to belong to a channel; if none is specified,
        FCM falls back to a channel called "Miscellaneous" with default
        (low-attention) importance. Declaring this ourselves means
        notifications land in a channel named "default" that we control —
        matters for consistent behavior and if we want to fine-tune
        importance/sound later without a bigger Notifee integration.
      -->
      <!--
        tools:replace is required here — @react-native-firebase/messaging
        ships its own empty version of this exact meta-data tag in its
        library AndroidManifest.xml, which conflicts with ours during
        manifest merge (confirmed by the "processDebugMainManifest" build
        error). This tells the merger to keep our value instead of theirs.
      -->
      <meta-data
          android:name="com.google.firebase.messaging.default_notification_channel_id"
          android:value="default"
          tools:replace="android:value" />

      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">

        <!-- App launcher -->
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>

        <!--
          Removed 2026-08-28: a broad, unscoped https autoVerify intent-filter
          (scheme=https, host=hub.instituteprojectmanagement.com, no
          pathPrefix) used to sit here. Because it had no path restriction it
          claimed EVERY link on the domain, including /activated/?key=... —
          so tapping the email activation link opened the app directly and
          never let the real WordPress endpoint that processes ?key= and
          flips the account active actually run. VerifyEmailScreen.tsx then
          just pattern-matched "activate" in the URL and showed a false
          "Account verified!" success screen, while the account was never
          actually activated server-side (confirmed: login right after threw
          the real "account not activated" error).

          Removing this filter means /activated/ links now open in a normal
          browser and genuinely hit WordPress, so activation actually works.
          The trade-off is the app no longer auto-returns afterward — to get
          that back properly, Robby needs to build a bounce page for
          /activated/ (same pattern as /linkedin-callback-app below: process
          the key server-side FIRST, then show a tappable link to a custom
          ipmhub:// scheme). Once that exists, re-add a SCOPED intent-filter
          here with android:pathPrefix set to only that specific path — never
          re-add it unscoped like this.
        -->

        <!--
          Custom-scheme deep link for the LinkedIn OAuth redirect and for
          password reset (already referenced in authApi.ts's resetPassword
          comments as ipmhub://reset-password, but never had a matching
          manifest entry until now).

          Why a custom scheme instead of reusing the https intent-filter
          above: Chrome Custom Tabs frequently render an https redirect as
          a normal web page in-tab rather than handing it to the app's App
          Link, especially for an automatic (non-tapped) redirect — which
          is exactly what happens for a LinkedIn user who's already logged
          in. A custom scheme like ipmhub:// has no "web page" Chrome could
          render instead, so once it's reached via a real link tap, Android
          must hand it to an app or show a disambiguation chooser — it
          can't silently stay in-browser the way an https URL can.
          autoVerify is intentionally omitted: Digital Asset Links
          verification only applies to https/http App Links, not custom
          schemes, so it isn't needed (or possible) here.
        -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="ipmhub" />
        </intent-filter>

      </activity>
    </application>

</manifest>
